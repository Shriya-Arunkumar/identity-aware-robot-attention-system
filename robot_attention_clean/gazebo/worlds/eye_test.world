<?xml version="1.0" ?>
<sdf version="1.6">

  <world name="eye_test">

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

   <include>
    <uri>model://eye</uri>
    <name>left_eye</name>
    <pose>0 0 1 0 0 0</pose>
  </include>

  <include>
    <uri>model://eye</uri>
    <name>right_eye</name>
    <pose>2 0 1 0 0 0</pose>
  </include>

  </world>

</sdf>