<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <model name="eye">
    <static>false</static>
    <link name="eye_base">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.1 0.1 0.1</size>
          </box>
        </geometry>
      </collision>
    </link>
    <link name="yaw_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <link name="eye_link">
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.256</ixx>
          <iyy>0.256</iyy>
          <izz>0.256</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="eye_visual">
        <geometry>
          <sphere>
            <radius>0.384000</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.97 0.98 1 1</ambient>
          <diffuse>0.97 0.98 1 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
      <visual name="blue_iris">
        <pose>0.000000 0.000000 -0.372000 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.148800</radius>
            <length>0.026400</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.06 0.32 0.58 1</ambient>
          <diffuse>0.06 0.32 0.58 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
      <visual name="pupil">
        <pose>0.000000 0.000000 -0.388800 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.069600</radius>
            <length>0.012000</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.008 0.012 0.02 1</ambient>
          <diffuse>0.008 0.012 0.02 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
      <visual name="eye_highlight">
        <pose>-0.036000 0.043200 -0.398400 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.021600</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
    </link>
    <joint name="eye_yaw_joint" type="revolute">
      <parent>eye_base</parent>
      <child>yaw_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.7854</lower>
          <upper>0.7854</upper>
        </limit>
      </axis>
    </joint>
    <joint name="eye_pitch_joint" type="revolute">
      <parent>yaw_link</parent>
      <child>eye_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-0.5</lower>
          <upper>0.5</upper>
        </limit>
      </axis>
    </joint>
    <joint name="world_fixed_joint" type="fixed">
      <parent>world</parent>
      <child>eye_base</child>
    </joint>
    <plugin name="eye_yaw_plugin" filename="libeye_yaw_plugin.so">
      <joint_name>eye_yaw_joint</joint_name>
      <ros_topic>/eye/target_angle</ros_topic>
      <min_angle>-0.7854</min_angle>
      <max_angle>0.7854</max_angle>
      <pitch_joint_name>eye_pitch_joint</pitch_joint_name>
      <pitch_ros_topic>/eye/pitch_angle</pitch_ros_topic>
      <pitch_min_angle>-0.5</pitch_min_angle>
      <pitch_max_angle>0.5</pitch_max_angle>
      <p_gain>25.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>4.0</d_gain>
      <blink_interval>3.5</blink_interval>
      <blink_close_time>0.055</blink_close_time>
      <blink_hold_time>0.015</blink_hold_time>
      <blink_open_time>0.105</blink_open_time>
    </plugin>
    <link name="upper_lid_link">
      <gravity>false</gravity>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="upper_lid">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://eye/meshes/upper_lid.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.88 0.67 0.53 1</ambient>
          <diffuse>0.88 0.67 0.53 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
    </link>
    <joint name="upper_lid_joint" type="revolute">
      <parent>eye_base</parent>
      <child>upper_lid_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-0.8</lower>
          <upper>0.8</upper>
        </limit>
      </axis>
    </joint>
    <link name="lower_lid_link">
      <gravity>false</gravity>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="lower_lid">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://eye/meshes/lower_lid.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.88 0.67 0.53 1</ambient>
          <diffuse>0.88 0.67 0.53 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
    </link>
    <joint name="lower_lid_joint" type="revolute">
      <parent>eye_base</parent>
      <child>lower_lid_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-0.8</lower>
          <upper>0.8</upper>
        </limit>
      </axis>
    </joint>
  </model>
</sdf>