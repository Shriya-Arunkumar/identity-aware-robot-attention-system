<?xml version="1.0"?>
<model>
  <name>eye</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>Shriya</name>
  </author>

  <description>
    Single sphere with an iris/pupil texture (materials/scripts/eye.material)
    mapped onto it -- no separate iris/pupil geometry. The textured sphere
    (eye_link) rotates about eye_yaw_joint (+-0.7854 rad / +-45 deg), fixed
    to a static eye_base via world_fixed_joint.
  </description>
</model>
